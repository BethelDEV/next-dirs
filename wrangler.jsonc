{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mkdirs-v1",
  "main": "worker.ts",
  // Runtime variables are managed in the dashboard; preserve them on deploy.
  "keep_vars": true,
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mkdirs-v1",
      // Local placeholder. Developer replaces this with the dashboard-created ID.
      "database_id": "4702f7de-ad80-4aa2-9854-bc070ba4358d",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true },
  "dev": { "ip": "127.0.0.1", "port": 8787 }
}
